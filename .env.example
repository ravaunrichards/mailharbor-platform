NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mailharbor:mailharbor-local-only-change-me@localhost:5432/mailharbor
DATABASE_SSL=false
JWT_SECRET=
TRUST_PROXY=false
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=
PG_POOL_MAX=10

# Outbound SMTP: use credentials from your verified mail-delivery provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Inbound provider webhook signing secret. Keep this separate from SMTP credentials.
INBOUND_WEBHOOK_SECRET=

# Realtime mailbox updates. In production, use the deployed wss:// service URL.
REALTIME_PUBLIC_URL=ws://localhost:3001
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
